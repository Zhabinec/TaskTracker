TASKTRACKER_ENVIRONMENT=development
TASKTRACKER_PRODUCT_TIMEZONE=Europe/Moscow
# Components preserve special characters in passwords; never paste a password into a URL.
TASKTRACKER_DB_HOST=127.0.0.1
TASKTRACKER_DB_PORT=15432
TASKTRACKER_DB_NAME=tasktracker
TASKTRACKER_DB_USER=tasktracker
TASKTRACKER_DB_PASSWORD=replace-with-the-same-password-as-compose
TASKTRACKER_SESSION_HOURS=168
# Shared PostgreSQL fixed-minute limits, across all workers.
TASKTRACKER_AUTH_GLOBAL_LIMIT=60
TASKTRACKER_AUTH_ACCOUNT_LIMIT=5
